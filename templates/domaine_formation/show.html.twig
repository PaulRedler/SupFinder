{% extends 'base.html.twig' %}

{% block title %}DomaineFormation{% endblock %}

{% block body %}
    <h1>DomaineFormation</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ domaine_formation.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ domaine_formation.nom }}</td>
            </tr>
            <tr>
                <th>Slug</th>
                <td>{{ domaine_formation.slug }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ domaine_formation.description }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_domaine_formation_index') }}">back to list</a>

    {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_domaine_formation_edit', {'id': domaine_formation.id}) }}">edit</a>{% endif %}

    {% if is_granted('ROLE_ADMIN') %}{{ include('domaine_formation/_delete_form.html.twig') }}{% endif %}
{% endblock %}
