{% extends 'base.html.twig' %}

{% block title %}Group{% endblock %}

{% block body %}
    <h1>Group</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ group.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ group.nom }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_group_index') }}">back to list</a>

    {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_group_edit', {'id': group.id}) }}">edit</a>{% endif %}

    {% if is_granted('ROLE_ADMIN') %}{{ include('group/_delete_form.html.twig') }}{% endif %}
{% endblock %}
