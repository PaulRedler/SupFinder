{% extends 'base.html.twig' %}

{% block title %}NiveauFormation{% endblock %}

{% block body %}
    <h1>NiveauFormation</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ niveau_formation.id }}</td>
            </tr>
            <tr>
                <th>Code</th>
                <td>{{ niveau_formation.code }}</td>
            </tr>
            <tr>
                <th>Libelle</th>
                <td>{{ niveau_formation.libelle }}</td>
            </tr>
            <tr>
                <th>Ordre</th>
                <td>{{ niveau_formation.ordre }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_niveau_formation_index') }}">back to list</a>

    {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_niveau_formation_edit', {'id': niveau_formation.id}) }}">edit</a>{% endif %}

    {% if is_granted('ROLE_ADMIN') %}{{ include('niveau_formation/_delete_form.html.twig') }}{% endif %}
{% endblock %}
