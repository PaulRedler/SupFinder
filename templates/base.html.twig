<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Supfinder — Recherche d'enseignement supérieur{% endblock %}</title>
        <meta name="description" content="Supfinder : recherchez les écoles, formations et accréditations du supérieur.">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('build/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="layout">
        <header class="site-header">
            <div class="container">
                <a class="brand" href="{{ path('app_ecole_index') }}">
                    <span class="brand__label">SupFinder</span>
                </a>

                <nav class="main-nav" aria-label="Navigation principale">
                    <a href="{{ path('app_ecole_index') }}">Accueil</a>
                    <a href="{{ path('app_formation_index') }}">Toutes les formations</a>
                    <a href="{{ path('app_ecole_index') }}">Toutes les écoles</a>
                    {% if app.user %}
                        <a href="{{ path('app_logout') }}" style="color: var(--color-marianne-blue);">Déconnexion ({{ app.user.prenom }})</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" style="color: var(--color-marianne-blue);">Connexion</a>
                        <a href="{{ path('app_register') }}" style="color: var(--color-marianne-blue);">S'inscrire</a>
                    {% endif %}
                </nav>
            </div>
        </header>

        <main class="site-main">
            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer">
            <div class="container footer-content">
                <div class="footer-brand">
                    <span class="brand__label">SupFinder</span>
                    <p class="footer-desc">Le portail de recherche d'enseignement supérieur.</p>
                </div>
                <div class="footer-links">
                    <a href="#">Plan du site</a>
                    <a href="#">Mentions légales</a>
                    <a href="#">Données personnelles</a>
                    <a href="#">Contact</a>
                </div>
            </div>
            <div class="footer-bottom">
                <div class="container">
                    <p>© {{ "now"|date("Y") }} SupFinder</p>
                </div>
            </div>
        </footer>
    </body>
</html>
