{% extends 'base.html.twig' %}

{% block title %}Status{% endblock %}

{% block body %}
    <h1>Status</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ status.id }}</td>
            </tr>
            <tr>
                <th>Libelle</th>
                <td>{{ status.libelle }}</td>
            </tr>
            <tr>
                <th>Info</th>
                <td>{{ status.info }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_status_index') }}">back to list</a>

    {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_status_edit', {'id': status.id}) }}">edit</a>{% endif %}

    {% if is_granted('ROLE_ADMIN') %}{{ include('status/_delete_form.html.twig') }}{% endif %}
{% endblock %}
