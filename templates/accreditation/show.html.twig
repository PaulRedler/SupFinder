{% extends 'base.html.twig' %}

{% block title %}Accreditation{% endblock %}

{% block body %}
    <h1>Accreditation</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ accreditation.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ accreditation.nom }}</td>
            </tr>
            <tr>
                <th>Organisme</th>
                <td>{{ accreditation.organisme }}</td>
            </tr>
            <tr>
                <th>Niveau</th>
                <td>{{ accreditation.niveau }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_accreditation_index') }}">back to list</a>

    {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_accreditation_edit', {'id': accreditation.id}) }}">edit</a>{% endif %}

    {% if is_granted('ROLE_ADMIN') %}{{ include('accreditation/_delete_form.html.twig') }}{% endif %}
{% endblock %}
