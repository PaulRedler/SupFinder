{% extends 'base.html.twig' %}

{% block title %}TypeEcole{% endblock %}

{% block body %}
    <h1>TypeEcole</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ type_ecole.id }}</td>
            </tr>
            <tr>
                <th>Libelle</th>
                <td>{{ type_ecole.libelle }}</td>
            </tr>
            <tr>
                <th>Info</th>
                <td>{{ type_ecole.info }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_type_ecole_index') }}">back to list</a>

    {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_type_ecole_edit', {'id': type_ecole.id}) }}">edit</a>{% endif %}

    {% if is_granted('ROLE_ADMIN') %}{{ include('type_ecole/_delete_form.html.twig') }}{% endif %}
{% endblock %}
