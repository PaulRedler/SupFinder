{% extends 'base.html.twig' %}

{% block title %}Formation index{% endblock %}

{% block body %}
    <h1>Formation index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Intitule</th>
                <th>Diplome</th>
                <th>ModeFormation</th>
                <th>CoutMin</th>
                <th>CoutMax</th>
                <th>Page</th>
                <th>Slug</th>
                <th>CreatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for formation in formations %}
            <tr>
                <td>{{ formation.id }}</td>
                <td>{{ formation.intitule }}</td>
                <td>{{ formation.diplome }}</td>
                <td>{{ formation.modeFormation }}</td>
                <td>{{ formation.coutMin }}</td>
                <td>{{ formation.coutMax }}</td>
                <td>{{ formation.page }}</td>
                <td>{{ formation.slug }}</td>
                <td>{{ formation.createdAt ? formation.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_formation_show', {'id': formation.id}) }}">show</a>
                    {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_formation_edit', {'id': formation.id}) }}">edit</a>{% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="10">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_formation_new') }}">Create new</a>{% endif %}
{% endblock %}
