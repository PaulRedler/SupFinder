{% extends 'base.html.twig' %}

{% block title %}Formation{% endblock %}

{% block body %}
    <h1>Formation</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ formation.id }}</td>
            </tr>
            <tr>
                <th>Intitule</th>
                <td>{{ formation.intitule }}</td>
            </tr>
            <tr>
                <th>Diplome</th>
                <td>{{ formation.diplome }}</td>
            </tr>
            <tr>
                <th>ModeFormation</th>
                <td>{{ formation.modeFormation }}</td>
            </tr>
            <tr>
                <th>CoutMin</th>
                <td>{{ formation.coutMin }}</td>
            </tr>
            <tr>
                <th>CoutMax</th>
                <td>{{ formation.coutMax }}</td>
            </tr>
            <tr>
                <th>Page</th>
                <td>{{ formation.page }}</td>
            </tr>
            <tr>
                <th>Slug</th>
                <td>{{ formation.slug }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ formation.createdAt ? formation.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_formation_index') }}">back to list</a>

    {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_formation_edit', {'id': formation.id}) }}">edit</a>{% endif %}

    {% if is_granted('ROLE_ADMIN') %}{{ include('formation/_delete_form.html.twig') }}{% endif %}
{% endblock %}
